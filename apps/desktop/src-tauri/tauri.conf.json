{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameDeck",
  "version": "0.1.0",
  "identifier": "com.gamedeck.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameDeck",
        "width": 1920,
        "height": 1080,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#11172d",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/artwork/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
